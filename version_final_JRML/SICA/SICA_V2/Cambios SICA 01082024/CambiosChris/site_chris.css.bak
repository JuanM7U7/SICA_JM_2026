* {
    font-family: tahoma;
    padding: 0px;
    margin: 0px;
    font-size: .9rem;
}

body {
    background-color: #F7F7F7;
}

a {
    text-decoration: none;
}

.containerP {
    display: flex;
    flex-direction: row;
}

.Container_Logo {
    width: 55vw;
    height: 100vh;
    background-color: #F7F7F7;
    display: flex;
    justify-content: center;
    align-items: center;
}

.logoCDH {
    width: 50vw;
}

.logoCDHP {
    width: 10vw;
    padding: 10px;
}
.logoModal{
    width:200px;
