    font-size: 30px;
    font-weight: bold;
    margin-left:340px;
    display: flex;
}
.cerrarDocumento {
    color: black;
    float: left;
    font-size: 30px;
    font-weight: bold;
    margin-top: 10px;
    margin-left: 95%;
